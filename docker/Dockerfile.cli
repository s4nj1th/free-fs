FROM python:3.11-slim

RUN pip install --no-cache-dir \
    grpcio==1.59.3 \
    grpcio-tools==1.59.3 \
    rich==13.7.0 \
    protobuf==4.25.0

WORKDIR /app

COPY proto/free_fs.proto ./proto/

RUN python -m grpc_tools.protoc \
    -I./proto \
    --python_out=./proto \
    --grpc_python_out=./proto \
    ./proto/free_fs.proto && \
    touch proto/__init__.py

RUN sed -i 's/import free_fs_pb2/from . import free_fs_pb2/' proto/free_fs_pb2_grpc.py 2>/dev/null || true

COPY cli/free_fs_cli.py ./

RUN echo '#!/bin/bash\npython /app/free_fs_cli.py "$@"' > /usr/local/bin/free-fs && \
    chmod +x /usr/local/bin/free-fs

RUN mkdir -p /workspace

WORKDIR /workspace

ENV FREE_FS_MASTER=master:50051

ENV PYTHONPATH=/app/proto:/app

ENTRYPOINT ["python", "/app/free_fs_cli.py"]

CMD ["shell"]
